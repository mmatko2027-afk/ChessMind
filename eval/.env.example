
# Application settings
APP_NAME=ChessMind
APP_VERSION=0.1.0

# AI provider settings
LLM_PROVIDER=mock
LLM_MODEL=gemini-3.8-flash
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_TIMEOUT_S=20
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=600
# Daily AI usage limits
DAILY_AI_BUDGET=1.0
DAILY_AI_REQUEST_LIMIT=100
RECORDED_MODE=record

# Mock provider failure simulation
MOCK_FAILURE_MODE=none

# Storage and logs
DB_PATH=data/chessmind.db
LOG_FILE=logs/chessmind.log
